{
  "name": "internal-services/service-sdk",
  "description": "Reusable PHP clients for New NG internal HTTP services.",
  "type": "library",
  "license": "proprietary",
  "require": {
    "php": ">=7.4",
    "ext-json": "*",
    "ext-swoole": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "Internal\\ServiceSdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Internal\\ServiceSdk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}

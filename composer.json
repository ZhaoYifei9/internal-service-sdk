{
  "name": "internal-services/service-sdk",
  "description": "Reusable PHP clients for internal HTTP services.",
  "type": "library",
  "license": "proprietary",
  "homepage": "https://github.com/ZhaoYifei9/internal-service-sdk",
  "keywords": [
    "hmac",
    "internal-services",
    "notification",
    "swoole"
  ],
  "require": {
    "php": ">=7.4",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "Internal\\ServiceSdk\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Internal\\ServiceSdk\\Tests\\": "tests/"
    }
  },
  "suggest": {
    "ext-swoole": "Required when using the default Swoole coroutine transport.",
    "guzzlehttp/guzzle": "Required when using GuzzleHttpTransport."
  },
  "scripts": {
    "test": "phpunit --colors=always"
  },
  "support": {
    "issues": "https://github.com/ZhaoYifei9/internal-service-sdk/issues",
    "source": "https://github.com/ZhaoYifei9/internal-service-sdk"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
